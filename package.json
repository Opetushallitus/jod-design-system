{
  "name": "@jod/design-system",
  "version": "0.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "files": [
    "dist",
    "lib/theme.css"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/main.js",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./dist/main.css": "./dist/main.css",
    "./lib/theme.css": "./lib/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite build -w",
    "build": "tsc && vite build",
    "lint": "oxlint",
    "format": "oxfmt",
    "test:unit": "vitest --run",
    "test:unit-update-snapshot": "vitest --run -u",
    "test:watch": "vitest --watch",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@ark-ui/react": "5.40.0",
    "@floating-ui/react": "0.27.20",
    "@headlessui/react": "2.2.10",
    "@internationalized/date": "3.12.4",
    "@zag-js/date-picker": "1.48.0",
    "cva": "1.0.0-beta.12",
    "focus-trap-react": "12.0.4",
    "motion": "14.14.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@guidepup/virtual-screen-reader": "0.33.0",
    "@lavamoat/allow-scripts": "5.1.1",
    "@lavamoat/preinstall-always-fail": "3.0.2",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-links": "10.6.7",
    "@storybook/addon-themes": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-storybook": "10.6.7",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "npm:typescript@6.0.3",
    "vite": "8.3.8",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "overrides": {
    "storybook": "$storybook"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.10.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^26.0.0",
    "npm": ">=11.10.0"
  },
  "lavamoat": {
    "allowScripts": {
      "@lavamoat/preinstall-always-fail": false,
      "vite>esbuild#0.28.2": false
    }
  }
}
